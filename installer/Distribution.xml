<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>LinguaFlow Dev 双语输入法</title>
  <organization>com.abandoned678</organization>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <options customize="never" require-scripts="false" hostArchitectures="@ARCHITECTURE@"/>
  <allowed-os-versions>
    <os-version min="26.0"/>
  </allowed-os-versions>
  <welcome file="Welcome.html" mime-type="text/html"/>
  <readme file="ReadMe.html" mime-type="text/html"/>
  <license file="License.txt" mime-type="text/plain"/>
  <conclusion file="Conclusion.html" mime-type="text/html"/>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" visible="false">
    <pkg-ref id="com.abandoned678.pkg.LinguaFlowDev.input-methods"/>
  </choice>
  <pkg-ref id="com.abandoned678.pkg.LinguaFlowDev.input-methods"
           version="@PACKAGE_VERSION@"
           onConclusion="none">LinguaFlow-input-methods.pkg</pkg-ref>
</installer-gui-script>
