#!/bin/zsh

set -u

target_volume=${3:-/}
target_root=${target_volume%/}
[[ -n "$target_root" ]] || target_root=/

chinese_app="$target_root/Library/Input Methods/LinguaFlowDev.app"
english_app="$target_root/Library/Input Methods/LinguaFlowDevEnglish.app"
chinese_binary="$chinese_app/Contents/MacOS/LinguaFlowDevIME"
english_binary="$english_app/Contents/MacOS/LinguaFlowDevEnglishIME"
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

if [[ "$target_root" != / ]]; then
  echo "LinguaFlow was installed on $target_root; input-source registration is deferred." >&2
  exit 0
fi

console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
if [[ -z "$console_user" || "$console_user" == root || "$console_user" == loginwindow ]]; then
  echo "No logged-in desktop user; LinguaFlow will be available after the next login." >&2
  exit 0
fi

console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || true)
console_gid=$(/usr/bin/id -g "$console_user" 2>/dev/null || true)
if [[ -z "$console_uid" || -z "$console_gid" ]]; then
  echo "Could not resolve the logged-in user's uid or gid; registration is deferred." >&2
  exit 0
fi

run_as_console_user() {
  /bin/launchctl asuser "$console_uid"     /usr/bin/sudo -H -u "$console_user" "$@"
}

if [[ -x "$lsregister" ]]; then
  run_as_console_user "$lsregister" -f "$chinese_app" >/dev/null 2>&1 || true
  run_as_console_user "$lsregister" -f "$english_app" >/dev/null 2>&1 || true
fi

install_and_verify() {
  local binary=$1
  local display_name=$2
  local attempt

  for attempt in 1 2 3; do
    if run_as_console_user "$binary" --install-input-source; then
      /bin/sleep 1
      if run_as_console_user "$binary" --verify-input-source; then
        return 0
      fi
    fi
    echo "$display_name registration attempt $attempt did not persist; retrying." >&2
    /bin/sleep 1
  done

  echo "Could not verify $display_name in the current login session; log out and back in once." >&2
  return 1
}

install_and_verify "$chinese_binary" "LinguaFlow Dev 中文" || true
install_and_verify "$english_binary" "LinguaFlow Dev English" || true

# A second fresh-process check catches the former false-success case where TIS
# returned noErr and a delayed stale-path notification removed the source after
# the helper exited.
/bin/sleep 1
if ! run_as_console_user "$chinese_binary" --verify-input-source; then
  install_and_verify "$chinese_binary" "LinguaFlow Dev 中文" || true
fi
if ! run_as_console_user "$english_binary" --verify-input-source; then
  install_and_verify "$english_binary" "LinguaFlow Dev English" || true
fi

registration_failed=0
run_as_console_user "$chinese_binary" --verify-input-source || registration_failed=1
run_as_console_user "$english_binary" --verify-input-source || registration_failed=1
if [[ "$registration_failed" -ne 0 ]]; then
  echo "LinguaFlow files were installed, but macOS deferred one or more input sources until the next login." >&2
fi

# Input-source state belongs to the current graphical login session. The fixed
# payload remains a valid installation if macOS defers that recoverable session
# refresh until the next login, so do not turn it into a partial-package error.
exit 0
